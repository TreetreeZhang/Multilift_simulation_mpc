# Ignore directories generated by colcon build
build/
install/
log/
temp/
# Temporary files generated by CMake
CMakeLists.txt.user
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# Ignore Python compiled files
__pycache__/
*.pyc
*.pyo
*.pyd

# Data / artifacts (keep .gitkeep)
data/**
!data/**/.gitkeep

# Common experiment outputs
*.npy
*.npz
*.pt
*.pth
*.png
*.csv

# Project-specific generated assets
src/px4-offboard/px4_offboard/Reference_traj_circle/
src/px4-offboard/px4_offboard/Reference_traj_fig8/
src/px4-offboard/px4_offboard/Evaluation results*/
src/px4-offboard/px4_offboard/trained data*/

# Ignore auto-generated files related to ROS 2
ros2_ws/.colcon/
ros2_ws/.vscode/

# VS Code related files (optional)
.vscode/
*.code-workspace

# Ignore JetBrains IDE (e.g., CLion) configuration files (optional)
.idea/
*.iml

# Ignore ROS 2 launch/logs directories
*.log
*.bag
*.db3

# Ignore files generated by Gazebo simulation
*.world~
*.sdf~
*.urdf~

# Ignore ROS 1 related files (if any)
devel/
.DS_Store
.codex